{
    "id": "com.porticobenefits.aesnapreport",
    "name": "AE Snap Report",
    "version": "1.0.0",
    "vendor": "Portico Benefits",
    "license": "",
    "eula": "",
    "description": "Daily high-level dashboard of Annual Enrollment progress: employer selection status, election-type breakdown, daily timeline, YoY comparison, and Synod/Region breakdown.",
    "newInstancePrefix": "AESnapReport",
    "icon": "https://bboehm1986.github.io/sac-ae-snap-report-widget/icon.svg",
    "webcomponents": [
        {
            "kind": "main",
            "tag": "com-porticobenefits-aesnapreport",
            "url": "https://bboehm1986.github.io/sac-ae-snap-report-widget/main.js",
            "integrity": "sha384-qqMxY5RUEcVDGHb9m0zi6zcAy2eBIZFdB2hRz3SzMViQgtfoA7ZqJvIXj8aJfr2n"
        }
    ],
    "properties": {
        "width": {
            "type": "integer",
            "default": 900
        },
        "height": {
            "type": "integer",
            "default": 600
        },
        "asOfLabel": {
            "type": "string",
            "default": "Live"
        }
    },
    "dataBindings": {
        "employerStatus": {
            "feeds": [
                {
                    "id": "dimensions",
                    "description": "Status / Synod-Region / Election Sub-Type / Date",
                    "type": "dimension"
                },
                {
                    "id": "measures",
                    "description": "Employer Count, Employee Count",
                    "type": "mainStructureMember"
                }
            ]
        },
        "dailyCounts": {
            "feeds": [
                {
                    "id": "dimensions",
                    "description": "Deprecated 2026-09-10 — no longer read by the widget. Timeline data now rides inside employerStatus's Date dimension instead (SAC's Builder UI can only bind one model per widget). Kept declared for manifest compatibility only.",
                    "type": "dimension"
                },
                {
                    "id": "measures",
                    "description": "Deprecated 2026-09-10 — see dimensions note",
                    "type": "mainStructureMember"
                }
            ]
        },
        "yoyComparison": {
            "feeds": [
                {
                    "id": "dimensions",
                    "description": "Benefit Type / Changed Flag",
                    "type": "dimension"
                },
                {
                    "id": "measures",
                    "description": "Member Count",
                    "type": "mainStructureMember"
                }
            ]
        }
    },
    "methods": {
        "refresh": {
            "description": "Re-renders the dashboard from the currently bound data"
        }
    },
    "events": {}
}
